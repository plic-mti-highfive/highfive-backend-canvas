ENV=dev
SERVER_NAME=hocuspocus-server
PORT=8585

# JWT_SECRET doit valoir exactement le CANVAS_JWT_SECRET du backend core :
# c'est le core qui signe les tokens canvas, ce service les verifie.
JWT_SECRET=change-me-canvas

# INTERNAL_SECRET doit valoir exactement le CANVAS_INTERNAL_SECRET du core :
# il protege GET /canvas/:canvasId/export, que seul le core appelle.
INTERNAL_SECRET=dev-internal-secret

# Stockage du document Yjs
BUCKET_NAME=hocuspocus-bucket-dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
# Region du client S3 (obligatoire : sans elle le demarrage echoue avec "Region is missing")
AWS_REGION=eu-west-3

# Queue des evenements canvas (chat)
REDIS_HOST=localhost
REDIS_PORT=6379
